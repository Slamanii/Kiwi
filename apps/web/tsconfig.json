{
  "extends": "@kiwi/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
